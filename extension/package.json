{
  "name": "conflictlens",
  "displayName": "ConflictLens",
  "description": "AI-powered semantic conflict and security risk detection — flags issues before merge.",
  "version": "0.0.1",
  "publisher": "conflictlens-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "conflictlens.scanNow",
        "title": "ConflictLens: Scan Now"
      }
    ],
    "configuration": {
      "title": "ConflictLens",
      "properties": {
        "codeguard.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "When true, ConflictLens will automatically scan for risks every time a file is saved. Defaults to false to avoid notification noise."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
