# ConflictLens Gemini Proxy — Environment Variables
#
# Copy this file to .env and fill in real values.
# The real .env is gitignored — never commit secrets.
#
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Your Gemini API key (gemini-2.5-flash).
# Get one at https://aistudio.google.com/app/apikey
# This key is held server-side and never sent to clients.
GEMINI_API_KEY=your_gemini_api_key_here

# Port the proxy listens on locally. Default: 3001
# (3000 is already used by the main ConflictLens analysis backend)
PORT=3001

# Number of free AI explanations each anonymous device may use.
# Default: 20. Adjust without code changes.
FREE_SCAN_LIMIT=20
