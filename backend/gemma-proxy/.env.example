# ConflictLens Gemma Proxy — Environment Variables
#
# Copy this file to .env and fill in real values.
# The real .env is gitignored — never commit secrets.
#
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Your API key (Gemma 4 / Gemini API key).
# Get one at https://aistudio.google.com/app/apikey
# This key is held server-side and never sent to clients.
GEMMA_API_KEY=your_api_key_here

# Model ID for Gemma 4. Default: gemma-4-26b-a4b-it
# Alternatives: gemma-4-31b-it (stronger reasoning), gemma-4-4b-it (lower latency)
AI_MODEL_ID=gemma-4-26b-a4b-it

# Port the proxy listens on locally. Default: 3001
# (3000 is already used by the main ConflictLens analysis backend)
PORT=3001

# Number of free AI explanations each anonymous device may use.
# Default: 20. Adjust without code changes.
FREE_SCAN_LIMIT=20
