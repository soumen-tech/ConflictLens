{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": "..",
    "paths": {
      "@codeguard/git-engine": ["packages/git-engine/src/index.ts"],
      "@codeguard/shared": ["shared/src/index.ts"]
    }
  },
  "ts-node": {
    "transpileOnly": false,
    "files": true
  }
}
